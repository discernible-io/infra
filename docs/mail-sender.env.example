# The live copy is ../infra-app/mail/smtp.env (mode 600).
# manage-mail-sender.sh creates it when missing.
# Passwords are one line each in:
#   ../infra-app/mail/smtp-password.<account>
# Legacy ../infra-app/mail/smtp-password is used for SMTP_DEFAULT when the
# named file is missing. Do not commit these files.

# Himalaya SMTP URL. Use smtp:// with STARTTLS, or smtps:// for implicit TLS.
#   smtp://smtp.example.com:587
#   smtps://smtp.example.com:465
SMTP_SERVER=
SMTP_STARTTLS=true

# Comma-separated account ids and which one send uses without --account.
SMTP_DEFAULT=github
SMTP_ACCOUNTS=github,founder

# One EMAIL (and optional FROM_NAME) per account id above.
SMTP_GITHUB_EMAIL=github@discernible.io
SMTP_GITHUB_FROM_NAME=

SMTP_FOUNDER_EMAIL=founder@discernible.io
SMTP_FOUNDER_FROM_NAME=
